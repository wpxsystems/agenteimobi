# Modelo do /etc/wpx/agenteimobi/.env (root, 0600). Preencher SÓ no servidor. Nunca commitar valores.
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://imobi.wpxsystems.com.br
PRIVACY_URL=https://imobi.wpxsystems.com.br/privacidade/atendimento
CORS_ORIGINS=https://imobi.wpxsystems.com.br
LOG_LEVEL=info

# Banco: Postgres compartilhado do vps2 (host "postgres" na rede wpxnet).
DATABASE_URL=postgres://agenteimobi_app:<senha-app>@postgres:5432/agenteimobi
DATABASE_MIGRATION_URL=postgres://agenteimobi_owner:<senha-owner>@postgres:5432/agenteimobi
DB_APP_ROLE=agenteimobi_app

# openssl rand -hex 48 (cada um)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Demonstração: WhatsApp simulado e simulador de conversas no painel (só com login).
# Trocar para false quando o número real da imobiliária for conectado.
DEMO_MODE=true
DEV_AUTO_LOGIN=false
WA_MOCK=false
WA_GRAPH_VERSION=v23.0
WA_ACCESS_TOKEN=
WA_TOKEN_ENC_KEY=        # openssl rand -hex 32
WA_APP_SECRET=           # sem app da Meta ainda: openssl rand -hex 24
WA_VERIFY_TOKEN=         # openssl rand -hex 16

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
REPLY_DEBOUNCE_MS=4000

EMAIL_PROVIDER=log
BILLING_ENABLED=false
SIGNUP_ENABLED=false
BILLING_PROVIDER=mock

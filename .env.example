# Copie para .env e preencha. NUNCA commite o .env.

NODE_ENV=development
PORT=3000
# URL pública (HTTPS) onde a API fica exposta — usada no link rastreado /r/...
PUBLIC_BASE_URL=https://agente.exemplo.com.br
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ---- Banco ----
# Aplicação: role aim_app (sem SUPERUSER/BYPASSRLS)
DATABASE_URL=postgres://aim_app:TROCAR@localhost:5432/agente_imobi
# Migrations/seed: owner do banco
DATABASE_MIGRATION_URL=postgres://aim_owner:TROCAR@localhost:5432/agente_imobi
DB_APP_ROLE=aim_app

# Usados pelo compose.yml para criar os roles
POSTGRES_PASSWORD=TROCAR
AIM_APP_PASSWORD=TROCAR

# ---- Auth (gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ---- WhatsApp Cloud API (Meta for Developers > seu App > WhatsApp) ----
# Conferir a versão atual da Graph API na documentação da Meta.
WA_GRAPH_VERSION=v23.0
# Token global: só para conta sem token próprio (instalação de um cliente só). Pode ficar vazio.
WA_ACCESS_TOKEN=
# Chave que cifra o token de cada conta no banco: 64 caracteres hex.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Gravar o token de uma conta: WA_TOKEN_NEW=<token> npm run tenant:wa-token -- <slug> [--waba <id>]
# Trocar esta chave invalida os tokens já gravados (é preciso gravá-los de novo).
WA_TOKEN_ENC_KEY=
# App Secret (Configurações do app > Básico) — valida a assinatura do webhook
WA_APP_SECRET=
# Texto livre que você define e repete na configuração do webhook na Meta (mín. 16 caracteres)
WA_VERIFY_TOKEN=
# Dev local: true = não envia nada para a Meta, só grava a mensagem (painel /painel com simulador). Ignorado em produção.
WA_MOCK=false
# Dev local: true = o painel entra sozinho como o admin do seed (SEED_TENANT_SLUG/SEED_ADMIN_EMAIL), sem senha. Ignorado em produção.
DEV_AUTO_LOGIN=false
# Conectar o WhatsApp pelo painel (cadastro incorporado da Meta). Exige o app aprovado como Tech Provider.
# META_APP_ID: id do mesmo app do WA_APP_SECRET. META_ES_CONFIG_ID: configuração do "Login do Facebook para Empresas".
# Vazios = o botão "Conectar WhatsApp" não aparece.
META_APP_ID=
META_ES_CONFIG_ID=
# Template aprovado para avisar o dono sobre lead transferido (opcional). 4 variáveis no corpo.
WA_OWNER_ALERT_TEMPLATE=
WA_OWNER_ALERT_TEMPLATE_LANG=pt_BR
# Resumo diário ao dono às 8h (categoria utilidade). 5 variáveis no corpo, nesta ordem:
# {{1}} quentes esperando o corretor, {{2}} total esperando, {{3}} leads novos ontem, {{4}} visitas hoje, {{5}} avisos.
# Vazio = o resumo aparece só na tela "Hoje" do painel.
WA_DAILY_DIGEST_TEMPLATE=
# Lembrete de visita ao lead quando já passou a janela de 24 h (categoria utilidade). 3 variáveis:
# {{1}} nome, {{2}} imóvel, {{3}} dia e hora. Dentro da janela o lembrete vai como texto livre, sem template.
WA_VISIT_REMINDER_TEMPLATE=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Conferir os IDs de modelo disponíveis em https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Atendimento ----
REPLY_DEBOUNCE_MS=4000
HISTORY_MAX_MESSAGES=30
FOLLOWUP_AFTER_MINUTES=180
FOLLOWUP_JOB_INTERVAL_MS=300000
PRIVACY_URL=https://agente.exemplo.com.br/privacidade/atendimento

# ---- E-mail (confirmação de e-mail, redefinição de senha) ----
# log = não envia (fora de produção os e-mails aparecem na caixa de saída do painel local)
# resend = envia pela API do Resend (https://resend.com), com domínio verificado no EMAIL_FROM
EMAIL_PROVIDER=log
EMAIL_FROM=Imobi <nao-responda@seudominio.com.br>
RESEND_API_KEY=

# ---- Modo piloto ----
# false/false = piloto: sem cobrança (nenhuma conta tem limite ou vencimento; planos somem do painel)
# e sem cadastro público (contas só por `npm run conta -- criar`). Para lançar, trocar para true/true.
BILLING_ENABLED=false
SIGNUP_ENABLED=false

# ---- Cobrança (planos) ----
# mock = simulado (só fora de produção; o painel mostra botões para simular pagamento/atraso/cancelamento)
# asaas = Asaas. Planos e preços ficam em src/config/plans.js.
BILLING_PROVIDER=mock
ASAAS_API_KEY=
# Sandbox: https://sandbox.asaas.com/api/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Texto que você define no Asaas (Integrações > Webhooks, URL https://<dominio>/webhooks/billing/asaas). Mín. 16 caracteres.
ASAAS_WEBHOOK_TOKEN=

# ---- Fila de jobs (aim_job) ----
# Intervalo de busca de jobs, jobs em paralelo por processo, tentativas por job
# e segundos até um job "executando" ser considerado travado e voltar para a fila.
JOB_POLL_MS=1000
JOB_CONCURRENCY=5
JOB_MAX_ATTEMPTS=5
JOB_STALE_SEC=300

# ---- Seed de desenvolvimento (npm run seed:dev) ----
SEED_TENANT_SLUG=cliente-teste
SEED_TENANT_NAME=Imobiliária Teste
SEED_ASSISTANT_NAME=Assistente
SEED_ADMIN_EMAIL=admin@exemplo.com.br
SEED_ADMIN_PASSWORD=
# phone_number_id do número na Meta (não é o telefone)
SEED_WA_PHONE_NUMBER_ID=
# Telefone do WhatsApp da empresa só com dígitos, com DDI: 5511999999999
SEED_WA_DISPLAY_PHONE=
# WhatsApp do dono/corretor para alertas, só dígitos com DDI
SEED_OWNER_WHATSAPP=
